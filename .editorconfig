root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.{xml,yml,yaml,md,js,jsx,json,css,html,sh,bash}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[Dockerfile]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
