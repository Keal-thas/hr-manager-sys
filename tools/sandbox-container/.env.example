# 复制为 .env 并填写真实值. .env 已被忽略, 不要提交.

# 宿主机上发布端口的绑定地址. 默认 0.0.0.0 (局域网可访问);
# 只允许本机访问时改为 127.0.0.1, 或改为具体网卡地址如 192.168.1.20.
BIND_HOST=0.0.0.0

# opencode 服务的 Basic Auth 密码 (必填, 用长随机串)
OPENCODE_SERVER_PASSWORD=

# GitHub token, 用于容器内 clone/push. 建议 fine-grained, 仅授权本仓库.
# 留空时 up.sh 会尝试使用 `gh auth token`.
GITHUB_TOKEN=

# 容器内 git 提交身份. 留空则不设置, 提交时会提示 Author identity unknown.
GIT_USER_NAME=
GIT_USER_EMAIL=

# 公有压缩包密码, 仅本机使用, 不写入仓库.
ZIP_PASSWORD=
