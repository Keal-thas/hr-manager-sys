#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "$staged" ]; then
  exit 0
fi

echo "[pre-commit] check staged paths"
forbidden='^(tmp\.docx|data/|target/|web/node_modules/|src/main/resources/static/|.*__pycache__/|\.env|.*\.pem|.*\.key|.*id_rsa.*)$'
if echo "$staged" | grep -Eq "$forbidden"; then
  echo "ERROR: forbidden generated or secret file staged:"
  echo "$staged" | grep -E "$forbidden" || true
  exit 1
fi

echo "[pre-commit] check large files"
while IFS= read -r file; do
  [ -f "$file" ] || continue
  size="$(wc -c <"$file")"
  if [ "$size" -gt 10485760 ]; then
    echo "ERROR: $file is larger than 10MB"
    exit 1
  fi
done <<< "$staged"

echo "[pre-commit] scan diff for secrets"
if git diff --cached -U0 | grep -E 'gh[pousr]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY' >/dev/null 2>&1; then
  echo "ERROR: possible secret detected in staged diff"
  exit 1
fi

echo "[pre-commit] whitespace check"
git diff --cached --check

echo "[pre-commit] compile"
if command -v mvn >/dev/null 2>&1; then
  mvn -q -DskipTests compile
fi

echo "[pre-commit] ok"
