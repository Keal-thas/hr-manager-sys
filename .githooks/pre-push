#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ ! -d web/node_modules ]; then
  echo "web/node_modules not found, run: cd web && npm ci"
  exit 1
fi

echo "[pre-push] frontend tests"
(cd web && npm test)

echo "[pre-push] frontend build"
(cd web && npm run build)

echo "[pre-push] generated assets not tracked"
tracked="$(git ls-files -- src/main/resources/static)"
if [ -n "$tracked" ]; then
  echo "ERROR: generated frontend assets are tracked by git:"
  echo "$tracked"
  exit 1
fi

echo "[pre-push] backend tests, coverage and package"
mvn -B -ntp verify

echo "[pre-push] ok"
